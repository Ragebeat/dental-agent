# Copy to .env and fill in. The .env file is not committed.

# Password for the "dental" Postgres user. Must match docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Full connection string (host port 5441). Overrides the pieces above when set.
# DATABASE_URL=postgresql://dental:change-me@127.0.0.1:5441/dental

# Store message contents and tool arguments in the database and traces.
# Off by default: the clinic data is medical. Turn on only for eval runs on synthetic data.
# LOG_CONTENT=0

# Трассы в Phoenix (E6): TRACE=1 включает, TRACE_CONTENT=1 добавляет тексты реплик (с маскированием телефонов/дат/карт; только синтетика).
# TRACE=0
# TRACE_CONTENT=0
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Ключ облачной модели для оценки (профиль or_agent в llm.toml). Необязателен: локальный Ollama ключа не требует.
OPENROUTER_API_KEY=

# Канал LINE (E7). Без LINE_CHANNEL_SECRET вебхук не запускается (подпись нечем проверить).
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_SALT=change-me         # соль для псевдонимизации userId: ключ сессии = sha256(соль + userId)[:16]
