# Copy to .env and fill in. The .env file is not committed.

# Password for the "dental" Postgres user. Must match docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Full connection string (host port 5441). Overrides the pieces above when set.
# DATABASE_URL=postgresql://dental:change-me@127.0.0.1:5441/dental

# Store message contents and tool arguments in the database and traces.
# Off by default: the clinic data is medical. Turn on only for eval runs on synthetic data.
# LOG_CONTENT=0

# Phoenix traces (E6): TRACE=1 turns them on, TRACE_CONTENT=1 adds message texts (phones/dates/cards masked; synthetic data only).
# TRACE=0
# TRACE_CONTENT=0
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Key for the cloud model used in evaluation (profile or_agent in llm.toml). Optional: a local Ollama needs no key.
OPENROUTER_API_KEY=

# LINE channel (E7). Without LINE_CHANNEL_SECRET the webhook does not start (nothing to verify the signature with).
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_SALT=change-me         # salt for pseudonymising userId: session key = sha256(salt + userId)[:16]
